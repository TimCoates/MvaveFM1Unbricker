#!/usr/bin/env bash
set -uo pipefail

SOURCE="${BASH_SOURCE[0]}"
case "$SOURCE" in
    /*) ;;
    *) SOURCE="$PWD/$SOURCE" ;;
esac
while [ -L "$SOURCE" ]; do
    SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
    TARGET="$(readlink "$SOURCE")"
    if [[ "$TARGET" = /* ]]; then
        SOURCE="$TARGET"
    else
        SOURCE="$SOURCE_DIR/$TARGET"
    fi
done
SCRIPT_DIR="$(cd -P -- "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
VENV="$SCRIPT_DIR/.venv"
JL_DIR="$SCRIPT_DIR/jl-uboot-tool"
UF2="$SCRIPT_DIR/transporter/fm1_transporter.uf2"

if [ "$#" -ne 0 ]; then
    printf 'MvaveFM1Unbrick takes no command-line arguments. Run it without arguments.\n' >&2
    exit 2
fi

ask_yes_no() {
    local answer
    read -r -p "$1 [y/N] " answer || return 1
    [[ "$answer" == "y" || "$answer" == "Y" || "$answer" == "yes" || "$answer" == "YES" ]]
}

python_at_least_39() {
    "$1" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' >/dev/null 2>&1
}

install_python() {
    if [ "$(uname -s)" = "Darwin" ] && command -v brew >/dev/null 2>&1; then
        if ask_yes_no "Python 3.9+ is required. Install Python with Homebrew?"; then
            brew install python
            return $?
        fi
    elif command -v apt-get >/dev/null 2>&1; then
        if ask_yes_no "Python 3, venv and pip are required. Install them with apt?"; then
            sudo -A apt-get update && sudo -A apt-get install -y python3 python3-venv python3-pip
            return $?
        fi
    elif command -v dnf >/dev/null 2>&1; then
        if ask_yes_no "Python 3 and pip are required. Install them with dnf?"; then
            sudo -A dnf install -y python3 python3-pip
            return $?
        fi
    elif command -v pacman >/dev/null 2>&1; then
        if ask_yes_no "Python 3 and pip are required. Install them with pacman?"; then
            sudo -A pacman -Sy --needed python python-pip
            return $?
        fi
    fi
    printf 'Install Python 3.9 or newer (including venv and pip), then run this command again.\n' >&2
    return 1
}

find_python() {
    if command -v python3 >/dev/null 2>&1 && python_at_least_39 python3; then
        PYTHON=python3
        return 0
    fi
    if command -v python >/dev/null 2>&1 && python_at_least_39 python; then
        PYTHON=python
        return 0
    fi
    if ! install_python; then
        return 1
    fi
    if command -v python3 >/dev/null 2>&1 && python_at_least_39 python3; then
        PYTHON=python3
        return 0
    fi
    printf 'Python 3.9 or newer was not found after the install attempt.\n' >&2
    return 1
}

create_venv() {
    if "$PYTHON" -m venv "$VENV"; then
        return 0
    fi
    printf 'Could not create the local Python environment at %s.\n' "$VENV" >&2
    if command -v apt-get >/dev/null 2>&1 && ask_yes_no "Install the missing venv support with apt?"; then
        sudo -A apt-get update && sudo -A apt-get install -y python3-venv &&
            "$PYTHON" -m venv "$VENV"
        return $?
    fi
    printf 'Install venv support for your Python distribution, then run this command again.\n' >&2
    return 1
}

dependencies_ready() {
    [ -x "$VENV/bin/python" ] || return 1
    "$VENV/bin/python" -c 'import serial, serial.tools.list_ports' >/dev/null 2>&1 || return 1
    [ -f "$JL_DIR/data/loaderblobs/usb/wl82loader.bin" ] || return 1
    [ -f "$UF2" ] || return 1
    "$VENV/bin/python" "$SCRIPT_DIR/fm1_transporter_recover.py" setup --check \
        >/dev/null 2>&1
}

prepare_dependencies() {
    if dependencies_ready; then
        printf 'Python environment, pyserial, JieLi loader and Transporter firmware are ready.\n'
        return 0
    fi
    printf 'Dependencies needed: a local Python environment, pyserial, jl-uboot-tool and its\n'
    printf 'pinned loader, plus the generated Transporter firmware. Setup may download files\n'
    printf 'and install Python packages from the internet.\n'
    if ! ask_yes_no "Allow setup to create/update .venv and fetch/install these dependencies?"; then
        printf 'Setup cancelled; no dependency download or installation was started.\n'
        return 1
    fi
    if [ ! -x "$VENV/bin/python" ] && ! create_venv; then
        return 1
    fi
    if ! "$VENV/bin/python" "$SCRIPT_DIR/fm1_transporter_recover.py" setup --yes; then
        printf 'Dependency setup failed. Review the error above and try again when ready.\n' >&2
        return 1
    fi
    if ! dependencies_ready; then
        printf 'Setup finished, but one or more required files/packages are still missing.\n' >&2
        return 1
    fi
    return 0
}

if ! find_python; then
    exit 1
fi

while true; do
    printf '\nMvave FM-1 Unbrick\n'
    printf '  1. Guided Transporter recovery\n'
    printf '  2. Check/setup dependencies only\n'
    printf '  3. Exit\n'
    read -r -p 'Choose [1-3]: ' choice || {
        printf '\nNo keyboard input; exiting without accessing the FM-1.\n'
        exit 1
    }

    case "$choice" in
        1)
            if prepare_dependencies; then
                "$VENV/bin/python" "$SCRIPT_DIR/fm1_transporter_recover.py" wizard
                result=$?
                if [ "$result" -ne 0 ]; then
                    printf 'Guided recovery ended with exit code %s.\n' "$result"
                fi
            fi
            ;;
        2)
            prepare_dependencies || true
            ;;
        3)
            exit 0
            ;;
        *)
            printf 'Choose 1, 2 or 3.\n'
            ;;
    esac
done
